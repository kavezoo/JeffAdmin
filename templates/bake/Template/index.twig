{#
/**
 * JeffAdmin bake — listanézet (index).
 *
 * Aktív oszlopok (config): id, name|title, visible, pos, created, modified, *_count
 * Egyéb mezők: kikommentelve, uncommenttel bekapcsolhatók.
 */
#}
{%- set fields = Bake.filterFields(fields, schema, modelObject, indexColumns, ['binary', 'text']) -%}
{%- set specialFields = ['id', 'visible', 'pos', 'created', 'modified'] -%}
{%- set secretFields = ['password', 'passwords', 'passwd']|merge(hidden|default([])) -%}
{%- set titleField = null -%}
{%- if 'name' in fields -%}
    {%- set titleField = 'name' -%}
{%- elseif 'title' in fields -%}
    {%- set titleField = 'title' -%}
{%- endif -%}
{%- set currencyExact = ['price', 'amount', 'cost', 'total', 'fee', 'net', 'gross', 'money', 'sum', 'ar', 'osszeg', 'dij', 'netto', 'brutto', 'unit_price', 'unitprice', 'net_price', 'gross_price'] -%}
{%- set currencySuffixes = ['price', 'amount', 'cost', 'total', 'fee', 'money', 'osszeg', 'dij'] -%}
{%- set otherFields = [] -%}
{%- for field in fields -%}
    {%- if field not in specialFields and field != titleField and field not in secretFields and not (field ends with '_count') -%}
        {%- set otherFields = otherFields|merge([field]) -%}
    {%- endif -%}
{%- endfor -%}
<?php
/**
 * Lista — megjelenítési kapcsolók ($show, plugin config + helyi felülírás)
 * rowCheckbox, rowId, name, visible, pos, created, modified, counts,
 * viewButton, editButton, deleteButton, rowDblClick
 *
 * @var \{{ namespace }}\View\AppView $this
 * @var iterable<\{{ entityClass }}> ${{ pluralVar }}
 * @var string|null $lastRecordId
 * @var int|null $lastRecordPage
 */

use Cake\Core\Configure;
use Cake\Utility\Inflector;

$show = Configure::read('JeffAdmin');
$showLocal = [];

$showLocal['index'] = [
//    'rowCheckbox'     => false,
//    'rowId'           => false,
//    'name'            => false,
//    'visible'         => false,
//    'pos'             => false,
//    'created'         => false,
//    'modified'        => false,
//    'counts'          => false,
//    'viewButton'      => false,
//    'editButton'      => false,
//    'deleteButton'    => false,
//    'relatedTables'   => false,
//    'rowDblClick'     => 'view',   // 'edit' | 'view' | 'none'
];

$show = array_merge($show['index'] ?? [], $showLocal['index']);

$rowDblClick = $show['rowDblClick'] ?? 'edit';
if (!in_array($rowDblClick, ['edit', 'view'], true)) {
    $rowDblClick = 'none';
}

$listPage = max(1, (int)$this->request->getQuery('page', 1));

$countColumns = [];
if (!empty($show['counts'])) {
    foreach (${{ pluralVar }} as ${{ singularVar }}) {
        foreach (array_keys(${{ singularVar }}->toArray()) as $field) {
            if (str_ends_with($field, '_count')) {
                $countColumns[$field] = Inflector::humanize(substr($field, 0, -6)) . ' count';
            }
        }
        break;
    }
}

$tableAttrs = '';
if (!empty($show['rowCheckbox'])) {
    $tableAttrs .= ' data-table-select';
}
if ($rowDblClick !== 'none') {
    $tableAttrs .= ' data-row-dblclick="' . h($rowDblClick) . '"';
}
?>
              <div class="row row-tight" style="margin-top: 16px;">
                <div class="col-md-12">
                  <div class="card shadow" aria-labelledby="{{ pluralVar }}-title">
                    <div class="card-header index-card-header">
                      <div class="index-card-header__title">
                        <strong id="{{ pluralVar }}-title"><?= __('{{ pluralHumanName }}') ?></strong>
                        <small class="d-block"><?= __('All {{ pluralHumanName|lower }}') ?></small>
                      </div>
                      <ul class="nav nav-tabs card-header-tabs index-card-header__tabs" id="indexTabs" role="tablist">
{{ element('Bake.related_nav', {'withSettings': false, 'relatedMsAuto': false}) }}
                      </ul>
                      <div class="index-card-header__actions">
                        <?= $this->Html->link(
                            $this->Icon->outline('plus') . ' ' . __('Add new {{ singularHumanName|lower }}'),
