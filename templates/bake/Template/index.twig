<?php endif; ?>
{% endif %}
{% for field in otherFields %}
    {%~ set isKey = false %}
    {%~ set assocDetails = null %}
    {%~ if associations.BelongsTo is defined %}
        {%~ for alias, details in associations.BelongsTo %}
            {%~ if field == details.foreignKey %}
                {%~ set isKey = true %}
                {%~ set assocDetails = details %}
            {%~ endif %}
        {%~ endfor %}
    {%~ endif %}
    {%~ set columnData = Bake.columnData(field, schema) %}
    {%~ set fieldLower = field|lower %}
    {%~ set isCurrency = fieldLower in currencyExact or fieldLower ends with '_price' or fieldLower ends with '_amount' or fieldLower ends with '_cost' or fieldLower ends with '_total' or fieldLower ends with '_fee' or fieldLower ends with '_money' or fieldLower ends with '_osszeg' or fieldLower ends with '_dij' %}
    {%~ set isEmail = fieldLower == 'email' or 'email' in fieldLower %}
    {%~ set cssClass = 'string' %}
    {%~ if isKey %}
        {%~ set cssClass = 'string' %}
    {%~ elseif isEmail %}
        {%~ set cssClass = 'email' %}
    {%~ elseif isCurrency %}
        {%~ set cssClass = 'number currency' %}
    {%~ elseif columnData.type == 'boolean' %}
        {%~ set cssClass = 'boolean' %}
    {%~ elseif columnData.type in ['integer', 'biginteger', 'smallinteger', 'tinyinteger'] %}
        {%~ set cssClass = 'integer' %}
    {%~ elseif columnData.type in ['float', 'decimal'] %}
        {%~ set cssClass = 'number' %}
    {%~ elseif columnData.type == 'date' %}
        {%~ set cssClass = 'date' %}
    {%~ elseif columnData.type == 'time' %}
        {%~ set cssClass = 'time' %}
    {%~ elseif columnData.type in ['datetime', 'timestamp'] %}
        {%~ set cssClass = 'datetime' %}
    {%~ endif %}
<?php /*
{% if isKey and assocDetails %}
                              <th class="{{ cssClass }}"><?= $this->Paginator->sort('{{ field }}', __('{{ assocDetails.property|humanize }}')) ?></th>
{% else %}
                              <th class="{{ cssClass }}"><?= $this->Paginator->sort('{{ field }}') ?></th>
{% endif %}
*/ ?>
{% endfor %}
<?php if (!empty($show['counts'])) : ?>
<?php     foreach ($countColumns as $countKey => $countLabel) : ?>
                              <th class="count"><?= $this->Paginator->sort($countKey, $countLabel) ?></th>
<?php     endforeach; ?>
<?php endif; ?>
{% if 'visible' in fields %}
<?php if (!empty($show['visible'])) : ?>
                              <th class="boolean"><?= $this->Paginator->sort('visible') ?></th>
<?php endif; ?>
{% endif %}
{% if 'pos' in fields %}
<?php if (!empty($show['pos'])) : ?>
