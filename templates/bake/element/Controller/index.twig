{#
/**
 * JeffAdmin — Controller index (aktív header kereső + session).
 *
 * BelongsTo keresés: leftJoinWith() asszociaciónként string alias
 * (tömb TypeError CakePHP 5-ben).
 */
#}
{%- set belongsTo = Bake.aliasExtractor(modelObj, 'BelongsTo') -%}
{%- set pk = modelObj.getPrimaryKey() -%}
{%- if pk is iterable -%}
    {%- set pkField = pk[0] -%}
{%- else -%}
    {%- set pkField = pk -%}
{%- endif -%}
{%- set tableSchema = modelObj.getSchema() -%}
{%- set secretFields = ['password', 'passwords', 'passwd'] -%}
{%- set searchOwn = [] -%}
{%- for column in tableSchema.columns() -%}
    {%- set colType = tableSchema.getColumnType(column) -%}
    {%- if colType in ['string', 'text'] and column != pkField and column not in secretFields -%}
        {%- set searchOwn = searchOwn|merge([column]) -%}
    {%- endif -%}
{%- endfor -%}
{%- set searchBelongs = [] -%}
{%- for assoc in belongsTo -%}
    {%- set assocObj = modelObj.getAssociation(assoc) -%}
    {%- set assocDisplay = assocObj.getDisplayField() -%}
    {%- if assocDisplay is iterable -%}
        {%- set assocDisplay = assocDisplay[0]|default(null) -%}
    {%- endif -%}
    {%- if assocDisplay -%}
        {%- set searchBelongs = searchBelongs|merge([{ 'alias': assoc, 'field': assocDisplay }]) -%}
    {%- endif -%}
{%- endfor -%}
{%- set hasSearchFields = searchOwn or searchBelongs %}
    /**
     * Index method
     *
     * @return \Cake\Http\Response|null|void Renders view
     */
    public function index()
    {
{% if belongsTo %}
        $query = $this->{{ currentModelName }}->find()
            ->contain({{ Bake.exportArray(belongsTo)|raw }});
{% else %}
        $query = $this->{{ currentModelName }}->find();
{% endif %}
{% if Bake.hasPlugin('Authorization') %}
        $query = $this->Authorization->applyScope($query);
{% endif %}

        // Header kereső (?search=) — sessionből a JeffAdmin AppController állítja vissza.
        $search = trim((string)$this->request->getQuery('search', ''));
{% if hasSearchFields %}
        if ($search !== '') {
            $parts = preg_split('/\s+/u', $search, -1, PREG_SPLIT_NO_EMPTY) ?: [];
            $like = '%' . implode('%', $parts) . '%';

            $query
{% for item in searchBelongs %}
                ->leftJoinWith('{{ item.alias }}')
{% endfor %}
                ->where([
                    'OR' => [
{% for column in searchOwn %}
                        '{{ currentModelName }}.{{ column }} LIKE' => $like,
{% endfor %}
{% for item in searchBelongs %}
                        '{{ item.alias }}.{{ item.field }} LIKE' => $like,
{% endfor %}
                    ],
                ])
                ->distinct(['{{ currentModelName }}.{{ pkField }}']);
        }
{% endif %}

        ${{ pluralName }} = $this->paginate($query);

        $this->set(compact('{{ pluralName }}'));
    }
