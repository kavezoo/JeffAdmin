{#
/**
 * JeffAdmin — Controller index (header kereső + session).
 *
 * Aktív keresőmező: name (ha nincs: title). Egyéb string / BelongsTo: kikommentelve.
 * Több szó: minden szóra külön WHERE OR (mezők) — a szavak AND-del kapcsolódnak
 * (bármely mezőben, bárhol megjelenhetnek, sorrend nem számít).
 * BelongsTo: leftJoinWith() asszociaciónként string alias (tömb TypeError CakePHP 5-ben).
 */
#}
{%- set belongsTo = Bake.aliasExtractor(modelObj, 'BelongsTo') -%}
{%- set pk = modelObj.getPrimaryKey() -%}
{%- if pk is iterable -%}
    {%- set pkField = pk[0] -%}
{%- else -%}
    {%- set pkField = pk -%}
{%- endif -%}
{%- set tableSchema = modelObj.getSchema() -%}
{%- set secretFields = ['password', 'passwords', 'passwd'] -%}
{%- set searchOwn = [] -%}
{%- for column in tableSchema.columns() -%}
    {%- set colType = tableSchema.getColumnType(column) -%}
    {%- if colType in ['string', 'text'] and column != pkField and column not in secretFields -%}
        {%- set searchOwn = searchOwn|merge([column]) -%}
    {%- endif -%}
{%- endfor -%}
{%- set searchBelongs = [] -%}
{%- for assoc in belongsTo -%}
    {%- set assocObj = modelObj.getAssociation(assoc) -%}
    {%- set assocDisplay = assocObj.getDisplayField() -%}
    {%- if assocDisplay is iterable -%}
        {%- set assocDisplay = assocDisplay[0]|default(null) -%}
    {%- endif -%}
    {%- if assocDisplay -%}
        {%- set searchBelongs = searchBelongs|merge([{ 'alias': assoc, 'field': assocDisplay }]) -%}
    {%- endif -%}
{%- endfor -%}
{%- set primarySearch = null -%}
{%- if 'name' in searchOwn -%}
    {%- set primarySearch = 'name' -%}
{%- elseif 'title' in searchOwn -%}
    {%- set primarySearch = 'title' -%}
{%- elseif searchOwn -%}
    {%- set primarySearch = searchOwn[0] -%}
{%- endif -%}
{%- set hasSearchFields = searchOwn or searchBelongs %}
    /**
     * Index method
     *
     * @return \Cake\Http\Response|null|void Renders view
     */
    public function index()
    {
        // Lapozás — globális: JeffAdmin.paginate.limit / maxLimit (config/paginate.php).
        // Helyi felülírás:
        // $this->paginate['limit'] = 10;
        // $this->paginate['maxLimit'] = 100;

{% if belongsTo %}
        $query = $this->{{ currentModelName }}->find()
            ->contain({{ Bake.exportArray(belongsTo)|raw }});
{% else %}
        $query = $this->{{ currentModelName }}->find();
{% endif %}
{% if Bake.hasPlugin('Authorization') %}
        $query = $this->Authorization->applyScope($query);
{% endif %}

        // Header kereső (?search=) — sessionből a JeffAdmin AppController állítja vissza.
        // Aktív: name (vagy title / első string). Többi mező / BelongsTo: uncomment.
        // Több szó: minden szóra AND; egy szón belül OR a mezőkön (bárhol, sorrend nélkül).
        $search = trim((string)$this->request->getQuery('search', ''));
{% if hasSearchFields and primarySearch %}
        if ($search !== '') {
            $words = preg_split('/\s+/u', $search, -1, PREG_SPLIT_NO_EMPTY) ?: [];

{% for item in searchBelongs %}
            // $query->leftJoinWith('{{ item.alias }}');
{% endfor %}

            foreach ($words as $word) {
                $like = '%' . addcslashes($word, '%_\\') . '%';
                $query->where([
                    'OR' => [
{% for column in searchOwn %}
{% if column == primarySearch %}
                        '{{ currentModelName }}.{{ column }} LIKE' => $like,
{% else %}
                        // '{{ currentModelName }}.{{ column }} LIKE' => $like,
{% endif %}
{% endfor %}
{% for item in searchBelongs %}
                        // '{{ item.alias }}.{{ item.field }} LIKE' => $like,
{% endfor %}
                    ],
                ]);
            }

            $query->distinct(['{{ currentModelName }}.{{ pkField }}']);
        }
{% endif %}

        ${{ pluralName }} = $this->paginate($query);

        $this->set(compact('{{ pluralName }}'));
    }
