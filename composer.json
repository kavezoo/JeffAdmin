{
    "name": "kavezoo/jeffadmin",
    "description": "JeffAdmin — CakePHP 5 admin UI plugin (layout, helpers, bake theme)",
    "type": "cakephp-plugin",
	"keywords": ["cakephp", "cooladmin", "admin", "plugin"],
	"homepage": "https://github.com/kavezoo/JeffAdmin/tree/main",
    "authors": [
        {
            "name": "Jeff Shoemaker",
            "email": "kavezoo@gmail.com",
            "homepage": "https://vzsfoto.hu",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "^5.0"
    },
    "suggest": {
        "cakephp/bake": "Required to bake controllers/templates with the JeffAdmin theme"
    },
    "autoload": {
        "psr-4": {
            "JeffAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffAdmin\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
